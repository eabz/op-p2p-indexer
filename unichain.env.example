# A Unichain indexer next to an OP Mainnet one on the same host, sharing its Redis (keys are
# prefixed by chain id, so two chains can share a database). Every port is shifted by 100.
#
#   docker compose up -d                                                         # OP Mainnet, Redis
#   docker compose -p unichain --env-file unichain.env.example up -d --no-deps indexer
#
# `-p unichain` gives the instance its own container and data volume; `--no-deps` keeps it
# from starting a second Redis. For a second instance of the SAME chain, use another Redis
# database instead: OP_INDEXER_REDIS_URL=redis://host.docker.internal:6379/1.
# See docs/storage.md, "Several instances on one host".

OP_INDEXER_CHAIN_ID=130
OP_INDEXER_REDIS_URL=redis://host.docker.internal:6379

OP_INDEXER_P2P_PORT=9322
OP_INDEXER_EL_PORT=30403
OP_INDEXER_L1_PORT=30404
OP_INDEXER_L1_BEACON_PORT=9101
OP_INDEXER_STREAM_PORT=50151

# Each instance runs its own L1 side (light client and L1 execution peers) if enabled.
# OP_INDEXER_L1_ENABLED=true
# OP_INDEXER_L1_CHECKPOINT=0x...
# Public addresses, if the host has them: the shifted ports.
# OP_INDEXER_EL_ADVERTISED_ADDR=203.0.113.7:30403
# OP_INDEXER_L1_ADVERTISED_ADDR=203.0.113.7:30404
