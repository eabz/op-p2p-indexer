# A Unichain indexer next to an OP Mainnet one on the same host. Every port is shifted by 100.
#
#   docker compose up -d                                                         # OP Mainnet
#   docker compose -p unichain --env-file unichain.env.example up -d
#
# `-p unichain` gives the instance its own container and `./data-unichain` its own data
# directory (create it once: `mkdir -p data-unichain && chown 10001:10001 data-unichain`),
# which holds everything it keeps: no service is shared. A second instance of the SAME chain
# needs only its own data directory and ports. See docs/storage.md, "Several instances on one
# host".

OP_INDEXER_CHAIN_ID=130
OP_INDEXER_HOST_DATA_DIR=./data-unichain

OP_INDEXER_P2P_PORT=9322
OP_INDEXER_EL_PORT=30403
OP_INDEXER_L1_PORT=30404
OP_INDEXER_L1_BEACON_PORT=9101
OP_INDEXER_STREAM_PORT=50151

# Each instance runs its own L1 side (light client and L1 execution peers) if enabled.
# OP_INDEXER_L1_ENABLED=true
# OP_INDEXER_L1_CHECKPOINT=0x...
# Public addresses, if the host has them: the shifted ports.
# OP_INDEXER_ADVERTISED_ADDR=203.0.113.7:9322
# OP_INDEXER_EL_ADVERTISED_ADDR=203.0.113.7:30403
# OP_INDEXER_L1_ADVERTISED_ADDR=203.0.113.7:30404
