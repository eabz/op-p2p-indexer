# Settings of every binary (`indexer`, `server`, `balancer` and the importer `import`): copy
# this file to `.env` and fill in what your binary needs.
#
#   cp .env.example .env
#   ./target/release/indexer
#
# Each binary reads `.env` in the current directory at startup, or the file given with
# `--env-file <path>` (or in OP_INDEXER_ENV_FILE); a variable set in the shell wins over the
# file. Lines are NAME=value; `#` starts a comment; an empty value means the default. A binary
# reads only its own variables, so one file serves all of them.
#
# Only what differs between machines belongs here: what to run, secrets, and where things are.
# Everything else has a default that fits; the tuning knobs (streams, memory, sessions) are
# sized from the machine's cores and memory and logged at startup. Each can still be set: see
# "Advanced settings" in docs/configuration.md. The importer's options are flags
# (`import <step> --help`).
#
# Keep `.env` private once it holds keys: git ignores it.

# === Required, by binary =====================================================================
#
# indexer   nothing: it runs OP Mainnet from data-op/ with gossip only. See "What to run".
# server    R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (the R2 block below)
# balancer  BALANCER_SERVER_KEYS, and the same three R2 variables (a read-only key is enough)
# import    IMPORT_API_TOKEN for `download` and `run`; the R2 keys (with write access) for
#           `verify` and `run`

# The Cloudflare account and a key to the chain's bucket. The importer and the one exporting
# server need write access; every other server, and the balancer, a read-only key. Never logged.
# OP_INDEXER_R2_ACCOUNT_ID=
# OP_INDEXER_R2_ACCESS_KEY_ID=
# OP_INDEXER_R2_SECRET_ACCESS_KEY=

# Balancer: comma-separated keys servers register with. Never logged.
# OP_INDEXER_BALANCER_SERVER_KEYS=

# Importer: the Envio HyperSync API token. Never logged.
# OP_INDEXER_IMPORT_API_TOKEN=

# === Optional ================================================================================

# --- What to run (indexer, server) -----------------------------------------------------------

# 10 OP Mainnet, 130 Unichain, 8453 Base. The importer and the balancer read it too.
# OP_INDEXER_CHAIN_ID=10
# Node state (identity, peers, the unsafe chain's journal, the indexer's archive or the
# server's tail). Default data-<chain>: data-op, data-unichain or data-base. A server needs one
# of its own (e.g. data-op-server): it refuses one holding an indexer's archive.
# OP_INDEXER_DATA_DIR=data-op
# true: join the execution network and fetch the receipts gossip does not carry.
# OP_INDEXER_EL_ENABLED=false
# true: also fetch the blocks between the archive's last one and the chain from execution
# peers. Turns the execution network on.
# OP_INDEXER_EL_SYNC=false
# true: follow Ethereum L1 and promote the blocks it commits to (safe, finalized). Needs the
# checkpoint below; turns the range sync, and so the execution network, on.
# OP_INDEXER_L1_ENABLED=false
# Root of a recent finalized beacon block, from a source you trust. Used on the first start,
# or when newer than the one the node saved.
# OP_INDEXER_L1_CHECKPOINT=0x...
# Server only: true to also run the exporter (the same as `server --export`). Exactly one
# server per deployment, the one holding the R2 write key.
# OP_INDEXER_EXPORT=false

# --- Stream (gRPC and Arrow Flight) ----------------------------------------------------------

# Local only by default. A server listens publicly (e.g. 0.0.0.0:50051), with API keys.
# OP_INDEXER_STREAM_LISTEN_ADDR=127.0.0.1:50051
# Comma-separated API keys; when set, every request needs `authorization: Bearer <key>`
# (default: none, no check). The balancer takes its user keys from here too. Never logged.
# OP_INDEXER_STREAM_API_KEYS=

# --- R2 --------------------------------------------------------------------------------------

# The chain's bucket (default <chain>-snapshot: op-, unichain- or base-snapshot).
# OP_INDEXER_R2_BUCKET=op-snapshot

# --- Balancer --------------------------------------------------------------------------------

# Server: the balancer to register with (unset: standalone), and one of its server keys
# (never logged). The importer's `fetch` asks it for chunk URLs.
# OP_INDEXER_BALANCER_URL=http://balancer.internal:50060
# OP_INDEXER_BALANCER_SERVER_KEY=
# Server: the public host:port of its stream, where the balancer sends clients. Default: the
# stream's listen address when it names an IP, else the public IP the execution network
# learns, with the stream's port. The server's name is its host name (OP_INDEXER_SERVER_ID).
# OP_INDEXER_SERVER_ADDRESS=203.0.113.7:50051
# Balancer: a read-only R2 key it signs raw chunk URLs with (`import fetch`, docs/serving.md
# 6.8). Both or neither; unset, raw plans are refused. Never logged.
# OP_INDEXER_R2_PRESIGN_ACCESS_KEY_ID=
# OP_INDEXER_R2_PRESIGN_SECRET_ACCESS_KEY=

# --- Importer --------------------------------------------------------------------------------

# Directory for the plan and the downloaded chunks; the same for every step and per chain.
# OP_INDEXER_IMPORT_STATE_DIR=import-state
# The chain's JSON-RPC endpoint, for the fields the archive leaves out (default by chain:
# Unichain's and Base's public ones, none for OP Mainnet). Kept here because its URL often
# holds a key.
# OP_INDEXER_IMPORT_RPC_ENDPOINT=
# `fetch`: the user key sent to the balancer, one of its OP_INDEXER_STREAM_API_KEYS. Never
# logged.
# OP_INDEXER_API_KEY=

# --- Logs ------------------------------------------------------------------------------------

# Log filter (tracing's syntax), e.g. `info,op_indexer_el=debug`.
# RUST_LOG=info
